# Evaluation results & generated plots
# We ignore generated outputs but keep the results/ directory tracked
results/*
!results/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS-generated files
.DS_Store
Thumbs.db
