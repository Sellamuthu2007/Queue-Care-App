# Database settings (Replace [PASSWORD] with your actual Supabase database password)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.plpuxsqudcprblwdypjj.supabase.co:5432/postgres

# Server settings
API_PORT=8080
APP_ENV=development

# JWT Secret keys (Use secure random strings in production)
JWT_ACCESS_SECRET=your-super-secret-access-key-should-be-very-long-and-secure
JWT_REFRESH_SECRET=your-super-secret-refresh-key-should-be-very-long-and-secure

# Expiry settings
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# OTP and Verification settings
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMS Provider (leave blank for development OTP console logging)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=
